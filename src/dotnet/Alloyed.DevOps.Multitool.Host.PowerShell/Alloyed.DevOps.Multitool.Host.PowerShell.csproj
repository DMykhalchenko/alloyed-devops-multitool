<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Copy NuGet package DLLs (e.g. Spectre.Console) to bin so Add-Type in PowerShell can load them. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alloyed.DevOps.Multitool.Core.Ast\Alloyed.DevOps.Multitool.Core.Ast.csproj" />
    <ProjectReference Include="..\Alloyed.DevOps.Multitool.Core.Catalog\Alloyed.DevOps.Multitool.Core.Catalog.csproj" />
    <ProjectReference Include="..\Alloyed.DevOps.Multitool.Core.Builders\Alloyed.DevOps.Multitool.Core.Builders.csproj" />
    <ProjectReference Include="..\Alloyed.DevOps.Multitool.Core.Decoration\Alloyed.DevOps.Multitool.Core.Decoration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>
</Project>
