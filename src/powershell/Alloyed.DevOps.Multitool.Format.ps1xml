<?xml version="1.0" encoding="utf-8" ?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>Alloyed.TransparencyModeStatus.Table</Name>
      <ViewSelectedBy>
        <TypeName>Alloyed.TransparencyModeStatus</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Enabled</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Override</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>SessionMode</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>OutputMode</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Verbose</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Profile</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Enabled</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Override</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SessionModeEnabled</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>OutputMode</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Verbose</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Profile</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>Alloyed.SessionModeStatus.Table</Name>
      <ViewSelectedBy>
        <TypeName>Alloyed.SessionModeStatus</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Enabled</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>ActiveAliasCount</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>ActiveAliases</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Enabled</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ActiveAliasCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ActiveAliases</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>Alloyed.SessionState.List</Name>
      <ViewSelectedBy>
        <TypeName>Alloyed.SessionState</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><Label>RuntimeConfigPath</Label><PropertyName>RuntimeConfigPath</PropertyName></ListItem>
              <ListItem><Label>RuntimeSessionEnabled</Label><PropertyName>RuntimeSessionEnabled</PropertyName></ListItem>
              <ListItem><Label>RuntimeTransparencyEnabled</Label><PropertyName>RuntimeTransparencyEnabled</PropertyName></ListItem>
              <ListItem><Label>RuntimeTransparencyProfile</Label><PropertyName>RuntimeTransparencyProfile</PropertyName></ListItem>
              <ListItem><Label>CurrentSessionModeEnabled</Label><PropertyName>CurrentSessionModeEnabled</PropertyName></ListItem>
              <ListItem><Label>CurrentTransparencyEnabled</Label><PropertyName>CurrentTransparencyEnabled</PropertyName></ListItem>
              <ListItem><Label>CurrentProfile</Label><PropertyName>CurrentProfile</PropertyName></ListItem>
              <ListItem><Label>CurrentOutputMode</Label><PropertyName>CurrentOutputMode</PropertyName></ListItem>
              <ListItem><Label>CurrentVerbose</Label><PropertyName>CurrentVerbose</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <View>
      <Name>Alloyed.CatalogMapping.Table</Name>
      <ViewSelectedBy>
        <TypeName>Alloyed.CatalogMapping</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Command</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Wrapper</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Command</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Wrapper</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>Alloyed.RuntimeConfiguration.List</Name>
      <ViewSelectedBy>
        <TypeName>Alloyed.RuntimeConfiguration</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><Label>RuntimeFailOnSeverity</Label><PropertyName>RuntimeFailOnSeverity</PropertyName></ListItem>
              <ListItem><Label>DefaultOutputPath</Label><PropertyName>DefaultOutputPath</PropertyName></ListItem>
              <ListItem><Label>SessionEnabled</Label><PropertyName>SessionEnabled</PropertyName></ListItem>
              <ListItem><Label>TransparencyEnabled</Label><PropertyName>TransparencyEnabled</PropertyName></ListItem>
              <ListItem><Label>TransparencyProfile</Label><PropertyName>TransparencyProfile</PropertyName></ListItem>
              <ListItem><Label>MockingEnabled</Label><PropertyName>MockingEnabled</PropertyName></ListItem>
              <ListItem><Label>MockingMode</Label><PropertyName>MockingMode</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <View>
      <Name>Alloyed.TransformValidationResult.List</Name>
      <ViewSelectedBy>
        <TypeName>Alloyed.TransformValidationResult</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><Label>Success</Label><PropertyName>Success</PropertyName></ListItem>
              <ListItem><Label>CommandsFound</Label><PropertyName>CommandsFound</PropertyName></ListItem>
              <ListItem><Label>CommandsReplaced</Label><PropertyName>CommandsReplaced</PropertyName></ListItem>
              <ListItem><Label>MissingCommandCount</Label><PropertyName>MissingCommandCount</PropertyName></ListItem>
              <ListItem><Label>DiagnosticCount</Label><PropertyName>DiagnosticCount</PropertyName></ListItem>
              <ListItem><Label>ErrorMessage</Label><PropertyName>ErrorMessage</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <View>
      <Name>Alloyed.RuntimeConfigValidationResult.List</Name>
      <ViewSelectedBy>
        <TypeName>Alloyed.RuntimeConfigValidationResult</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><Label>BasePath</Label><PropertyName>BasePath</PropertyName></ListItem>
              <ListItem><Label>ConfigPath</Label><PropertyName>ConfigPath</PropertyName></ListItem>
              <ListItem><Label>RuntimeDefaultOutputPath</Label><PropertyName>RuntimeDefaultOutputPath</PropertyName></ListItem>
              <ListItem><Label>SessionEnabled</Label><PropertyName>SessionEnabled</PropertyName></ListItem>
              <ListItem><Label>TransparencyEnabled</Label><PropertyName>TransparencyEnabled</PropertyName></ListItem>
              <ListItem><Label>ConsoleOutputMode</Label><PropertyName>ConsoleOutputMode</PropertyName></ListItem>
              <ListItem><Label>RuntimeMaxRetries</Label><PropertyName>RuntimeMaxRetries</PropertyName></ListItem>
              <ListItem><Label>RuntimeRetryDelaySec</Label><PropertyName>RuntimeRetryDelaySec</PropertyName></ListItem>
              <ListItem><Label>RuntimeExponentialBackoff</Label><PropertyName>RuntimeExponentialBackoff</PropertyName></ListItem>
              <ListItem><Label>RuntimePreview</Label><PropertyName>RuntimePreview</PropertyName></ListItem>
              <ListItem><Label>RuntimeTimeoutSec</Label><PropertyName>RuntimeTimeoutSec</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <View>
      <Name>Alloyed.RuntimeConfigInitializationResult.List</Name>
      <ViewSelectedBy>
        <TypeName>Alloyed.RuntimeConfigInitializationResult</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><Label>ConfigPath</Label><PropertyName>ConfigPath</PropertyName></ListItem>
              <ListItem><Label>OutputMode</Label><PropertyName>OutputMode</PropertyName></ListItem>
              <ListItem><Label>EnableTransparency</Label><PropertyName>EnableTransparency</PropertyName></ListItem>
              <ListItem><Label>TransparencyProfile</Label><PropertyName>TransparencyProfile</PropertyName></ListItem>
              <ListItem><Label>SessionEnabled</Label><PropertyName>SessionEnabled</PropertyName></ListItem>
              <ListItem><Label>RuntimeMaxRetries</Label><PropertyName>RuntimeMaxRetries</PropertyName></ListItem>
              <ListItem><Label>RuntimeExponentialBackoff</Label><PropertyName>RuntimeExponentialBackoff</PropertyName></ListItem>
              <ListItem><Label>RuntimePreview</Label><PropertyName>RuntimePreview</PropertyName></ListItem>
              <ListItem><Label>ApplyToCurrentSession</Label><PropertyName>ApplyToCurrentSession</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
  </ViewDefinitions>
</Configuration>
