pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  environment {
    PODMAN_CONNECTION = 'centos10-root'
    IMAGE_NAME = 'alloyed-devops-multitool:ci'
    PROJECT_DIR = 'projects/alloyed-devops-multitool'
  }

  stages {
    stage('Smoke: Podman Remote') {
      steps {
        bat 'podman.exe --connection %PODMAN_CONNECTION% info'
      }
    }

    stage('Build Image') {
      steps {
        bat '''
          podman.exe --connection %PODMAN_CONNECTION% build ^
            -f %PROJECT_DIR%/Containerfile ^
            -t %IMAGE_NAME% ^
            %PROJECT_DIR%
        '''
      }
    }

    stage('Run Build/Test In Container') {
      steps {
        bat 'podman.exe --connection %PODMAN_CONNECTION% run --rm %IMAGE_NAME%'
      }
    }
  }

  post {
    always {
      bat 'podman.exe --connection %PODMAN_CONNECTION% images'
    }
  }
}
