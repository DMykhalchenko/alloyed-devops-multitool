{
    "version": 1,
    "options": {
        "skipValidationOnDraft": true
    },
    "title": {
        "minLength": 8,
        "maxLength": 180,
        "pattern": "^(?!\\s)(?!.*\\s$).+$",
        "description": "descriptive title without leading or trailing whitespace and without auto-generated merge prefixes",
        "disallowPrefixes": [
            "WIP",
            "Draft",
            "[WIP]",
            "[Draft]",
            "Merge pull request #",
            "Pull request #"
        ]
    },
    "jira": {
        "mode": "anyOf",
        "pattern": "[A-Z][A-Z0-9]+-\\d+"
    }
}
